// esperado: complex(1, -9)
let fun relevante z = abs(z) > 3, fun inverter z = conj(z), fun selecionar p xs = if xs == [] then [] else let var h = head xs, var t = tail xs in if p(h) then h : selecionar(p, t) else selecionar(p, t), fun mapear f xs = if xs == [] then [] else let var h = head xs, var t = tail xs in f(h) : mapear(f, t), fun somar z w = complex(re(z) + re(w), im(z) + im(w)), fun reduzir f acc xs = if xs == [] then acc else let var h = head xs, var t = tail xs in reduzir(f, f(acc, h), t) in reduzir(somar, complex(0, 0), mapear(inverter, selecionar(relevante, [complex(1, 2), complex(3, 4), complex(-2, 5), complex(0, -3)])))
